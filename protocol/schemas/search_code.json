{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cemp.spec/v1/schemas/search_code.json",
  "title": "SearchCodeTool",
  "description": "Context-rich code search across files to find unique replacement targets and anchors.",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Search string or regular expression pattern."
        },
        "path_glob": {
          "type": "string",
          "default": "**/*",
          "description": "Glob pattern filtering target paths (e.g. 'src/**/*.py')."
        },
        "regex": {
          "type": "boolean",
          "default": false,
          "description": "If true, pattern is parsed as a regular expression."
        },
        "context_lines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "default": 3,
          "description": "Number of lines of surrounding context to include before and after matches."
        }
      },
      "required": ["pattern"],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "total_matches": {
          "type": "integer",
          "minimum": 0
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "match_content": { "type": "string" },
              "context_before": {
                "type": "array",
                "items": { "type": "string" }
              },
              "context_after": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["file", "line", "match_content"],
            "additionalProperties": false
          }
        }
      },
      "required": ["total_matches", "matches"],
      "additionalProperties": false
    }
  }
}
